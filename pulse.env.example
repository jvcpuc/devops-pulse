# DevOps Pulse AI — ambiente local (gitignored)

APP_ENV=development
DEMO_MODE=false
LOG_LEVEL=INFO

# GitHub
GITHUB_OWNER=n8n-io
GITHUB_REPOSITORY=n8n
GITHUB_TOKEN=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Kokoro
KOKORO_BASE_URL=http://localhost:8880
KOKORO_ENABLED=true
KOKORO_VOICE=pf_dora

# n8n
N8N_BASE_URL=http://localhost:5678

# WhatsApp (Evolution)
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://127.0.0.1:8080
WHATSAPP_TOKEN=
EVOLUTION_INSTANCE=devops-pulse
# destino: grupo de operações (não use o próprio número logado)
WHATSAPP_TO=

# Thresholds
STALE_PR_DAYS=3
LOW_CI_SUCCESS_RATE=80.0
HIGH_ISSUE_VOLUME=10
